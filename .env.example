# Copy this file to .env and replace the placeholder locally.
FORTYGUARD_API_KEY=your_fortyguard_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com
FORTYGUARD_TIMEOUT_SECONDS=30
FORTYGUARD_POLL_INTERVAL_SECONDS=2
FORTYGUARD_MAX_POLL_ATTEMPTS=60
HEATSHIELD_DEMO_COUNTRY=United States
HEATSHIELD_DEMO_CITY=Phoenix
HEATSHIELD_DEMO_STATE=Arizona
HEATSHIELD_DEMO_LATITUDE=33.4484
HEATSHIELD_DEMO_LONGITUDE=-112.0740
HEATSHIELD_MAX_DATA_AGE_MINUTES=30
HEATSHIELD_MAX_FUTURE_SKEW_MINUTES=5
# 100 m is the verified Phoenix TCM demo grid.
HEATSHIELD_SITE_POLYGON_RADIUS_METERS=300
HEATSHIELD_LIVE_GRANULARITY_METERS=100
HEATSHIELD_TIMESTAMP_TOLERANCE_MINUTES=5
# Comma-separated browser origins. Add your deployed frontend URL here.
HEATSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
HEATSHIELD_AGENT_MODEL=deepseek-v4-flash
HEATSHIELD_AGENT_TIMEOUT_SECONDS=30
# Google Maps JavaScript API browser key; restrict by HTTP referrer and API.
VITE_MAP=your_google_maps_browser_key_here
