FORTYGUARD_BASE_URL=https://api.fortyguard.com
FORTYGUARD_TIMEOUT_SECONDS=30
FORTYGUARD_POLL_INTERVAL_SECONDS=2
FORTYGUARD_MAX_POLL_ATTEMPTS=60
HEATSHIELD_DEMO_COUNTRY=United States
HEATSHIELD_DEMO_CITY=Phoenix
HEATSHIELD_DEMO_STATE=Arizona
HEATSHIELD_DEMO_LATITUDE=33.4484
HEATSHIELD_DEMO_LONGITUDE=-112.0740
HEATSHIELD_MAX_DATA_AGE_MINUTES=30
